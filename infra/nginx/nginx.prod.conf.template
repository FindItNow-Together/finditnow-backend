# ---------- UPSTREAMS ----------
upstream auth_service_upstream {
    server auth:8080;
}

upstream user_service_upstream {
    server user:8081;
}

upstream shop_service_upstream {
    server shop:8083;
}

upstream order_service_upstream {
    server order:8084;
}

upstream delivery_service_upstream {
    server delivery:${DELIVERY_SERVICE_PORT};
}

upstream file_gateway_service_upstream {
    server file:8090;
}

upstream frontend_upstream {
    server frontend:3000;
}

# ---------- CORS ORIGIN MAP ----------
# Allowed origins from environment variables
# FRONTEND_ORIGIN and FRONTEND_DEV_ORIGIN can be set in .env
map $http_origin $cors_origin {
    default "";
    "${FRONTEND_ORIGIN}" $http_origin;
    "${FRONTEND_DEV_ORIGIN}" $http_origin;
}

# ---------- HTTP REDIRECT ----------
server {
    listen 80;
    server_name finditnow-together.duckdns.org;

    include /etc/nginx/api-proxy.conf;

    location /health {
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS SERVER ----------
server {
    listen 443 ssl;
    server_name finditnow-together.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/finditnow-together.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/finditnow-together.duckdns.org/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    resolver 127.0.0.11 valid=10s;

    include /etc/nginx/api-proxy.conf;

    # ---------- HEALTH ----------
    location /health {
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    # ---------- FRONTEND ----------
    location / {
        proxy_pass http://frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
