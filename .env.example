DELIVERY_SERVICE_HOST=http://delivery
FILE_GATEWAY_SERVICE_HOST=http://file

#Docker Postgres Configuration
DB_HOST=localhost //use postgres in dockerized environment
DB_PORT=5432
DB_USER=devuser
DB_PASSWORD=dev@123
DB_POOL_SIZE=5
DB_DDL_AUTO=update
DB_TIMEZONE=Asia/Kolkata

# Redis Configuration
REDIS_HOST=localhost //use redis in dockerized environment
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=256bit-base64-url-encoded-string

# SMTP Email Server Configuration
EMAIL_APP_USERNAME=services.mancomunited@gmail.com
EMAIL_APP_PWD="app_email_app_password"

# CORS Configuration for Nginx
# Frontend production origin
FRONTEND_ORIGIN=https://finditnow-frontend.duckdns.org
# Development frontend origin (leave empty if not needed)
