SHOP_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
DELIVERY_SERVICE_PORT=8086
FILE_GATEWAY_SERVICE_PORT=8090

#SERVICE_HOSTS(docker side)
AUTH_SERVICE_HOST=http://auth
USER_SERVICE_HOST=http://user
SHOP_SERVICE_HOST=http://shop
